{
  "manifest_version": 3,
  "name": "PDF Toolbox",
  "version": "1.1.0",
  "description": "Detecta PDFs nas páginas (Gmail, sites, visualizadores) e permite extrair páginas, dividir, juntar, girar, converter em imagem e mais.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PDF Toolbox",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["webRequest", "webNavigation", "storage", "tabs", "downloads", "scripting", "debugger"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "select-area": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Selecionar uma área da página para salvar"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
